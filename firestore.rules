rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function signed(){return request.auth != null;}
 function admin(){return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
 match /admins/{uid} { allow get: if signed() && request.auth.uid == uid; }
 match /users/{uid} {
 allow read: if admin() || (signed() && request.auth.uid == uid);
 allow create, update: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['email','lastSeen']) && request.resource.data.email == request.auth.token.email && request.resource.data.lastSeen == request.time;
 match /progress/{question} {
 allow read: if admin() || (signed() && request.auth.uid == uid);
 allow delete: if signed() && request.auth.uid == uid;
 allow create, update: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['correct']) && request.resource.data.correct is bool;
 }
 }
 }
}

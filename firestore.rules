rules_version = '2';
service cloud.firestore { match /databases/{database}/documents { match /users/{uid}/progress/{question} { allow read, delete: if request.auth != null && request.auth.uid == uid; allow create, update: if request.auth != null && request.auth.uid == uid && request.resource.data.keys().hasOnly(['correct']) && request.resource.data.correct is bool; } } }
